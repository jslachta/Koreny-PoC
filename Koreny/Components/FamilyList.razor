@using Koreny.Models
@using Koreny.Services

@* Seznam rodin. Zrcadlí panel osob s jedním rozdílem: výběr rodiny je jen výběr a NEmění kořen
   rodokmenu — rodina není osoba, takže by se muselo hádat, který její člen má být kořenem. *@

<div class="k-panel-head">
    <h2 class="k-panel-title">Rodiny</h2>
    <div class="k-toolbar-group">
        <button type="button" class="k-btn k-btn--sm" @onclick="OnNew" disabled="@(Document is null)">+ Rodina</button>
    </div>
</div>

@if (HasFamilies)
{
    <div class="k-search">
        <span class="k-search-icon" aria-hidden="true">🔍</span>
        <input type="search"
               class="k-search-input"
               placeholder="Hledat jméno nebo ID…"
               aria-label="Hledat rodinu"
               @bind="FilterValue"
               @bind:event="oninput" />
        @if (IsFilterActive)
        {
            <span class="k-search-count">@Visible.Count/@Document!.Families.Count</span>
            <button type="button" class="k-btn k-btn--ghost k-btn--sm" @onclick="ClearFilterAsync" title="Zrušit hledání" aria-label="Zrušit hledání">×</button>
        }
    </div>
}

<p class="k-status" role="status">
    @if (!HasFamilies)
    {
        <text>Zatím žádné rodiny.</text>
    }
    else if (Selected is { } selectedFamily)
    {
        <text>Vybraná rodina: </text>

        <strong>@FamilyDisplay.Partners(Document, selectedFamily)</strong>

        <text> · @ChildrenLabel(selectedFamily)</text>
        @if (FamilyDisplay.MarriageYear(selectedFamily) is { } marriageYear)
        {
            <text> · sňatek @marriageYear</text>
        }
    }
    else
    {
        <text>Vyberte rodinu v seznamu.</text>
    }
</p>

<div class="k-panel-body k-panel-body--flush">
    @if (Document is null || Document.Individuals.Count == 0)
    {
        <div class="k-empty">
            <div class="k-empty-icon" aria-hidden="true">👪</div>
            <h3 class="k-empty-title">Rodina potřebuje osoby</h3>
            <p class="k-empty-text">Rodina spojuje dvě osoby. Přidejte je vedle v panelu <strong>Osoby</strong> a pak se sem vraťte.</p>
        </div>
    }
    else if (!HasFamilies)
    {
        <div class="k-empty">
            <div class="k-empty-icon" aria-hidden="true">👪</div>
            <h3 class="k-empty-title">Zatím žádná rodina</h3>
            <p class="k-empty-text">Rodina spojuje rodiče s jejich dětmi — bez ní jsou osoby v rodokmenu samostatné ostrovy.</p>
            <div class="k-empty-actions">
                <button type="button" class="k-btn k-btn--primary" @onclick="OnNew">+ Rodina</button>
            </div>
        </div>
    }
    else if (Visible.Count == 0)
    {
        <div class="k-empty">
            <div class="k-empty-icon" aria-hidden="true">🔍</div>
            <h3 class="k-empty-title">Žádná rodina nenalezena</h3>
            <p class="k-empty-text">Hledání „@Filter“ neodpovídá žádná rodina.</p>
            <div class="k-empty-actions">
                <button type="button" class="k-btn k-btn--outline" @onclick="ClearFilterAsync">Zrušit hledání</button>
            </div>
        </div>
    }
    else
    {
        <div class="k-list">
            @foreach (var f in Visible)
            {
                var rowId = f.Id;
                var selected = rowId == SelectedId;
                <div class="k-row @(selected ? "is-selected" : "")">
                    <button type="button"
                            class="k-row-main"
                            @onclick="@(() => OnSelect.InvokeAsync(rowId))"
                            aria-pressed="@(selected ? "true" : "false")">
                        <span class="k-row-name">@FamilyDisplay.Partners(Document, f)</span>
                        <span class="k-row-years">@ChildrenLabel(f)</span>
                    </button>
                    @if (selected)
                    {
                        <button type="button" class="k-btn k-btn--sm k-btn--outline" @onclick="@(() => OnEdit.InvokeAsync(rowId))" title="Upravit vybranou rodinu">Upravit</button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public GedcomDocument? Document { get; set; }

    [Parameter]
    public string? SelectedId { get; set; }

    [Parameter]
    public string Filter { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> FilterChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    [Parameter]
    public EventCallback<string> OnEdit { get; set; }

    [Parameter]
    public EventCallback OnNew { get; set; }

    private bool HasFamilies => Document is not null && Document.Families.Count > 0;

    private bool IsFilterActive => !string.IsNullOrWhiteSpace(Filter);

    private string FilterValue
    {
        get => Filter;
        set => FilterChanged.InvokeAsync(value);
    }

    /// <summary>Seřazené rodiny po aplikaci hledání (stejná pravidla jako u osob, viz FamilySearch).</summary>
    private List<GedcomFamily> Visible =>
        Document is null
            ? new List<GedcomFamily>()
            : FamilySearch.Filter(Document, Sorted, Filter).ToList();

    /// <summary>
    /// Rodiny podle jmen rodičů, aby se seznam dal projít stejně jako seznam osob.
    /// Rodiny bez rodičů jdou na konec — jinak by je závorka v popisku vytlačila na začátek,
    /// kde by rozpracované záznamy zakrývaly ty hotové.
    /// </summary>
    private IEnumerable<GedcomFamily> Sorted =>
        Document!.Families
            .OrderBy(f => f.HusbandId is null && f.WifeId is null)
            .ThenBy(f => FamilyDisplay.Partners(Document, f), StringComparer.OrdinalIgnoreCase);

    private GedcomFamily? Selected =>
        Document is null || string.IsNullOrEmpty(SelectedId)
            ? null
            : Document.Families.FirstOrDefault(f => f.Id == SelectedId);

    /// <summary>Počet dětí v protějšku sloupce s letopočty u osob — rodina ho má vždy, datum sňatku často ne.</summary>
    private static string ChildrenLabel(GedcomFamily family) =>
        family.ChildrenIds.Count == 0
            ? "bez dětí"
            : $"{family.ChildrenIds.Count} {Czech.Plural(family.ChildrenIds.Count, "dítě", "děti", "dětí")}";

    private Task ClearFilterAsync() => FilterChanged.InvokeAsync(string.Empty);
}
