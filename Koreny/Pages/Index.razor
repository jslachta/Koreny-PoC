@page "/"
@using Koreny.Models
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject GedcomParser Parser
@inject AppState AppState
@inject IJSRuntime JSRuntime

@* Tečka v titulku = rozpracovaná transakce, konvence editorů (vidíš ji i na skryté záložce). *@
<PageTitle>@(_dirty ? "• Kořeny — neuloženo" : "Kořeny")</PageTitle>

<header class="k-header">
    <svg viewBox="0 0 100 100" width="46" height="46"
         xmlns="http://www.w3.org/2000/svg">
        <rect width="100" height="100" rx="16" fill="#2D5A3D"/>
        <rect x="46" y="38" width="8" height="28" rx="2" fill="#E8D5A3"/>
        <line x1="50" y1="42" x2="30" y2="24" stroke="#E8D5A3" stroke-width="4" stroke-linecap="round"/>
        <line x1="50" y1="42" x2="70" y2="24" stroke="#E8D5A3" stroke-width="4" stroke-linecap="round"/>
        <line x1="50" y1="50" x2="22" y2="38" stroke="#E8D5A3" stroke-width="3" stroke-linecap="round"/>
        <line x1="50" y1="50" x2="78" y2="38" stroke="#E8D5A3" stroke-width="3" stroke-linecap="round"/>
        <line x1="50" y1="66" x2="30" y2="82" stroke="#E8D5A3" stroke-width="4" stroke-linecap="round"/>
        <line x1="50" y1="66" x2="70" y2="82" stroke="#E8D5A3" stroke-width="4" stroke-linecap="round"/>
        <line x1="50" y1="66" x2="20" y2="72" stroke="#E8D5A3" stroke-width="3" stroke-linecap="round"/>
        <line x1="50" y1="66" x2="80" y2="72" stroke="#E8D5A3" stroke-width="3" stroke-linecap="round"/>
        <line x1="50" y1="66" x2="50" y2="84" stroke="#E8D5A3" stroke-width="3" stroke-linecap="round"/>
    </svg>
    <div>
        <h1 class="k-title">Kořeny</h1>
        <p class="k-tagline">Rodokmen z vašeho GEDCOM souboru</p>
    </div>
</header>

@if (!string.IsNullOrEmpty(_loadError))
{
    <p class="k-alert" role="alert">@_loadError</p>
}

<div class="k-layout">
    <div class="k-col-main">
        <div class="k-toolbar-row">
            @* Transakce nad souborem (princip 4). Chip „Neuloženo" patří k tlačítku, které ji uzavře. *@
            <div class="k-card k-toolbar">
                <div class="k-toolbar-group">
                    <InputFile id="gedcomInput" OnChange="OnFileSelectedAsync" style="display:none" accept=".ged" />
                    <button type="button" class="k-btn" @onclick="StartNewDocumentAsync" disabled="@(!HasAnyRecords())" title="Zahodit vše a začít s prázdným rodokmenem">Nový rodokmen</button>
                    <button type="button" class="k-btn" onclick="document.getElementById('gedcomInput').click()">Načíst GEDCOM</button>
                    <button type="button" class="k-btn" @onclick="LoadSampleGedcomAsync">Vzorová rodina</button>
                    @* Commit transakce; při neuložených změnách je to zvýrazněný další krok. *@
                    <button type="button" class="k-btn @(_dirty ? "k-btn--primary" : "")" @onclick="ExportGedcomAsync" disabled="@(_doc is null)">Uložit GEDCOM</button>
                </div>

                @if (_dirty)
                {
                    <span class="k-chip k-chip--dirty" role="status" title="Změny žijí jen v této záložce, dokud je neuložíte do souboru">
                        <span class="k-dot" aria-hidden="true"></span> Neuloženo
                    </span>
                }
            </div>

            @* Akce nad rodokmenem samotným. Chip s počty říká, čeho se týkají. *@
            <div class="k-card k-toolbar">
                <div class="k-toolbar-group">
                    <button type="button" class="k-btn k-btn--primary" @onclick="OpenTopolaOverlay" disabled="@(_doc is null || _doc.Individuals.Count == 0)">Zobrazit rodokmen</button>
                    <button type="button" class="k-btn k-btn--outline" @onclick="StartTreeDownload" disabled="@(_doc is null || _doc.Individuals.Count == 0 || _downloadingTree)">
                        @(_downloadingTree ? "Připravuji…" : "Stáhnout rodokmen")
                    </button>
                </div>

                @if (_doc is not null && _doc.Individuals.Count > 0)
                {
                    <span class="k-chip" role="status">
                        <b>@_doc.Individuals.Count</b> @Plural(_doc.Individuals.Count, "osoba", "osoby", "osob")
                        · <b>@_doc.Families.Count</b> @Plural(_doc.Families.Count, "rodina", "rodiny", "rodin")
                    </span>
                }
            </div>
        </div>

        <div class="k-card k-canvas">
            @if (_doc is not null && _doc.Individuals.Count > 0)
            {
                <HourglassTree Document="@_doc"
                               RootPersonId="@_rootPersonId"
                               OnPersonSelected="OnTreePersonSelected"
                               OnPersonDoubleClicked="OnTreePersonDoubleClicked" />
            }
            else
            {
                <div class="k-empty">
                    <svg viewBox="0 0 100 100" width="46" height="46" xmlns="http://www.w3.org/2000/svg">
                        <rect width="100" height="100" rx="16" fill="#2D5A3D" />
                        <rect x="46" y="38" width="8" height="28" rx="2" fill="#E8D5A3" />
                        <line x1="50" y1="42" x2="30" y2="24" stroke="#E8D5A3" stroke-width="4" stroke-linecap="round" />
                        <line x1="50" y1="42" x2="70" y2="24" stroke="#E8D5A3" stroke-width="4" stroke-linecap="round" />
                        <line x1="50" y1="66" x2="30" y2="82" stroke="#E8D5A3" stroke-width="4" stroke-linecap="round" />
                        <line x1="50" y1="66" x2="70" y2="82" stroke="#E8D5A3" stroke-width="4" stroke-linecap="round" />
                        <line x1="50" y1="66" x2="50" y2="84" stroke="#E8D5A3" stroke-width="3" stroke-linecap="round" />
                    </svg>
                    <h2 class="k-empty-title">Tady bude váš rodokmen</h2>
                    <p class="k-empty-text">Načtěte GEDCOM export z MyHeritage nebo Ancestry — nebo si to nejdřív vyzkoušejte na vzorové rodině.</p>
                    <div class="k-empty-actions">
                        <button type="button" class="k-btn k-btn--primary" @onclick="LoadSampleGedcomAsync">Zkusit vzorovou rodinu</button>
                        <button type="button" class="k-btn k-btn--outline" onclick="document.getElementById('gedcomInput').click()">Načíst GEDCOM</button>
                    </div>
                </div>
            }
        </div>
    </div>

    @* Dva rovnocenné panely. Rozepsaný formulář je globálně jen jeden (_panel), takže druhý
       panel v tu chvíli zůstává seznamem — nelze mít dvě neuložené rozdělané editace naráz. *@
    <div class="k-col-sides">
        <aside class="k-card k-panel">
            @if (_panel == PanelView.Person)
            {
                <div class="k-panel-head">
                    <h2 class="k-panel-title">@(_personIsNew ? "Nová osoba" : "Upravit osobu")</h2>
                </div>
                <div class="k-panel-body">
                    <div class="k-form">
                        <div class="k-field">
                            <label class="k-label" for="p-given">Jméno</label>
                            <input id="p-given" class="k-input" @bind="_personForm.Given" />
                        </div>
                        <div class="k-field">
                            <label class="k-label" for="p-surname">Příjmení</label>
                            <input id="p-surname" class="k-input" @bind="_personForm.Surname" />
                        </div>
                        <div class="k-field">
                            <label class="k-label" for="p-maiden">Rodné příjmení</label>
                            <input id="p-maiden" class="k-input" @bind="_personForm.MaidenSurname" placeholder="např. Svobodová" />
                            <p class="k-hint-text">Příjmení před sňatkem. Ukládá se jako samostatné jméno s typem <code>maiden</code>, jak to popisuje GEDCOM 5.5.1.</p>
                        </div>
                        <div class="k-field">
                            <label class="k-label" for="p-sex">Pohlaví</label>
                            <select id="p-sex" class="k-select" @bind="_personForm.SexCode">
                                <option value="0">Neznámé</option>
                                <option value="1">Muž</option>
                                <option value="2">Žena</option>
                            </select>
                        </div>
                        <div class="k-field">
                            <label class="k-label" for="p-bdate">Datum narození</label>
                            <input id="p-bdate" class="k-input" @bind="_personForm.BirthDate" placeholder="např. 3 MAR 1901" />
                        </div>
                        <div class="k-field">
                            <label class="k-label" for="p-bplace">Místo narození</label>
                            <input id="p-bplace" class="k-input" @bind="_personForm.BirthPlace" />
                        </div>
                        <div class="k-field">
                            <label class="k-label" for="p-ddate">Datum úmrtí</label>
                            <input id="p-ddate" class="k-input" @bind="_personForm.DeathDate" placeholder="např. 1 MAR 1980" />
                        </div>
                        <div class="k-field">
                            <label class="k-label" for="p-dplace">Místo úmrtí</label>
                            <input id="p-dplace" class="k-input" @bind="_personForm.DeathPlace" />
                        </div>
                        <div class="k-field">
                            <label class="k-label" for="p-note">Poznámka</label>
                            <input id="p-note" class="k-input" @bind="_personForm.NoteFirst" />
                        </div>
                    </div>
                </div>
                <div class="k-panel-foot">
                    <button type="button" class="k-btn k-btn--primary" @onclick="SavePerson">Uložit</button>
                    <button type="button" class="k-btn k-btn--ghost" @onclick="CancelPanel">Zrušit</button>
                    <span class="k-spacer"></span>
                    @if (!_personIsNew)
                    {
                        <button type="button" class="k-btn k-btn--danger" @onclick="DeletePerson">Smazat</button>
                    }
                </div>
            }
            else
            {
                <div class="k-panel-head">
                    <h2 class="k-panel-title">Osoby</h2>
                    <div class="k-toolbar-group">
                        <button type="button" class="k-btn k-btn--sm" @onclick="StartNewPersonAsync" disabled="@(_doc is null)">+ Osoba</button>
                    </div>
                </div>

                @if (_doc is not null && _doc.Individuals.Count > 0)
                {
                    <div class="k-search">
                        <span class="k-search-icon" aria-hidden="true">🔍</span>
                        <input type="search"
                               class="k-search-input"
                               placeholder="Hledat jméno nebo ID…"
                               aria-label="Hledat osobu"
                               @bind="_personFilter"
                               @bind:event="oninput" />
                        @if (IsPersonFilterActive())
                        {
                            <span class="k-search-count">@VisiblePersonCount()/@_doc.Individuals.Count</span>
                            <button type="button" class="k-btn k-btn--ghost k-btn--sm" @onclick="ClearPersonFilter" title="Zrušit hledání" aria-label="Zrušit hledání">×</button>
                        }
                    </div>
                }

                @* Jméno z dokumentu jde do stránky jako text, ne jako HTML (princip 8). *@
                <p class="k-status" role="status">
                    @if (_doc is null || _doc.Individuals.Count == 0)
                    {
                        <text>Zatím žádné osoby.</text>
                    }
                    else if (SelectedPerson() is { } selectedPerson)
                    {
                        <text>Vybraná osoba: </text>

                        <strong>@PersonDisplay.Name(selectedPerson)</strong>
                    }
                    else
                    {
                        <text>Vyberte osobu v seznamu.</text>
                    }
                </p>

                <div class="k-panel-body k-panel-body--flush">
                    @if (_doc is null || _doc.Individuals.Count == 0)
                    {
                        <div class="k-empty">
                            <div class="k-empty-icon" aria-hidden="true">🌱</div>
                            <h3 class="k-empty-title">Zatím tu nikdo není</h3>
                            <p class="k-empty-text">Přidejte první osobu tlačítkem <strong>+ Osoba</strong>, nebo vlevo načtěte vzorovou rodinu.</p>
                        </div>
                    }
                    else if (VisiblePersonCount() == 0)
                    {
                        <div class="k-empty">
                            <div class="k-empty-icon" aria-hidden="true">🔍</div>
                            <h3 class="k-empty-title">Nikdo nenalezen</h3>
                            <p class="k-empty-text">Hledání „@_personFilter“ neodpovídá žádná osoba.</p>
                            <div class="k-empty-actions">
                                <button type="button" class="k-btn k-btn--outline" @onclick="ClearPersonFilter">Zrušit hledání</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="k-list">
                            @foreach (var p in GetVisibleIndividuals())
                            {
                                var rowId = p.Id;
                                var selected = rowId == _rootPersonId;
                                <div class="k-row @(selected ? "is-selected" : "")">
                                    <button type="button"
                                            class="k-row-main"
                                            @onclick="@(() => SelectPerson(rowId))"
                                            aria-pressed="@(selected ? "true" : "false")">
                                        <span class="k-row-name">@PersonDisplay.Name(p)</span>
                                        <span class="k-row-years">@PersonDisplay.LifespanYears(p)</span>
                                    </button>
                                    @if (selected)
                                    {
                                        <button type="button" class="k-btn k-btn--sm k-btn--outline" @onclick="@(() => OpenPersonForEditAsync(rowId))" title="Upravit vybranou osobu">Upravit</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </aside>

        <aside class="k-card k-panel">
            @if (_panel == PanelView.Family)
            {
                <div class="k-panel-head">
                    <h2 class="k-panel-title">@(_familyIsNew ? "Nová rodina" : "Upravit rodinu")</h2>
                </div>
                @if (_doc is null || _doc.Individuals.Count == 0)
                {
                    <div class="k-panel-body">
                        <div class="k-empty">
                            <div class="k-empty-icon" aria-hidden="true">👤</div>
                            <h3 class="k-empty-title">Nejdřív potřebujeme aspoň jednu osobu</h3>
                            <p class="k-empty-text">Rodina spojuje dvě osoby, které zatím nemáte. Přidejte první osobu — a vrátíme vás rovnou sem.</p>
                            <div class="k-empty-actions">
                                <button type="button" class="k-btn k-btn--primary" @onclick="StartNewPersonThenReturnToFamilyAsync">Přidat osobu</button>
                                <button type="button" class="k-btn k-btn--outline" @onclick="CancelPanel">Zpět</button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="k-panel-body">
                        <div class="k-form">
                            <div class="k-field">
                                <label class="k-label" for="f-husb">Manžel</label>
                                <select id="f-husb" class="k-select" @bind="_familyForm.HusbandId" @bind:after="OnFamilyParentsChanged">
                                    <option value="">(žádný)</option>
                                    @foreach (var p in _doc.Individuals)
                                    {
                                        <option value="@p.Id">@PersonDisplay.Name(p) · @PersonDisplay.LifespanYears(p) (@p.Id)</option>
                                    }
                                </select>
                            </div>
                            <div class="k-field">
                                <label class="k-label" for="f-wife">Manželka</label>
                                <select id="f-wife" class="k-select" @bind="_familyForm.WifeId" @bind:after="OnFamilyParentsChanged">
                                    <option value="">(žádná)</option>
                                    @foreach (var p in _doc.Individuals)
                                    {
                                        <option value="@p.Id">@PersonDisplay.Name(p) · @PersonDisplay.LifespanYears(p) (@p.Id)</option>
                                    }
                                </select>
                            </div>
                            <fieldset class="k-fieldset">
                                <legend class="k-legend">Děti</legend>
                                @if (!HasFamilyParentSelected())
                                {
                                    @* Seznam potomků dává smysl až podle rodičů — bez nich nelze vyloučit cykly. *@
                                    <div class="k-hint">
                                        <span class="k-hint-icon" aria-hidden="true">👆</span>
                                        <span>Nejdřív vyberte manžela nebo manželku. Podle nich pak nabídneme osoby, které mohou být dětmi.</span>
                                    </div>
                                }
                                else
                                {
                                    var candidates = FamilyChildCandidates();
                                    @if (candidates.Count == 0)
                                    {
                                        <div class="k-hint">
                                            <span class="k-hint-icon" aria-hidden="true">∅</span>
                                            <span>Žádná osoba nemůže být dítětem této rodiny — ostatní jsou její rodiče nebo předci.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="k-check-list">
                                            @foreach (var c in candidates)
                                            {
                                                var cid = c.Id;
                                                <label class="k-check">
                                                    <input type="checkbox" checked="@IsFamilyChildChecked(cid)" @onchange="@(e => OnFamilyChildToggle(cid, e))" />
                                                    <span class="k-check-name">@PersonDisplay.Name(c)</span>
                                                    @* Jmenovci jsou v rodokmenu pravidlo, ne výjimka — bez let se nedají rozlišit. *@
                                                    <span class="k-check-years">@PersonDisplay.LifespanYears(c)</span>
                                                    <span class="k-check-id">@cid</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                }
                            </fieldset>
                            <div class="k-field">
                                <label class="k-label" for="f-mdate">Datum sňatku</label>
                                <input id="f-mdate" class="k-input" @bind="_familyForm.MarriageDate" placeholder="např. 15 JUN 1925" />
                            </div>
                            <div class="k-field">
                                <label class="k-label" for="f-mplace">Místo sňatku</label>
                                <input id="f-mplace" class="k-input" @bind="_familyForm.MarriagePlace" />
                            </div>
                        </div>
                    </div>
                    <div class="k-panel-foot">
                        <button type="button" class="k-btn k-btn--primary" @onclick="SaveFamily">Uložit</button>
                        <button type="button" class="k-btn k-btn--ghost" @onclick="CancelPanel">Zrušit</button>
                        <span class="k-spacer"></span>
                        @if (!_familyIsNew)
                        {
                            <button type="button" class="k-btn k-btn--danger" @onclick="DeleteFamilyAsync">Smazat</button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="k-panel-head">
                    <h2 class="k-panel-title">Rodiny</h2>
                    <div class="k-toolbar-group">
                        <button type="button" class="k-btn k-btn--sm" @onclick="StartNewFamilyAsync" disabled="@(_doc is null)">+ Rodina</button>
                    </div>
                </div>

                @if (_doc is not null && _doc.Families.Count > 0)
                {
                    <div class="k-search">
                        <span class="k-search-icon" aria-hidden="true">🔍</span>
                        <input type="search"
                               class="k-search-input"
                               placeholder="Hledat jméno nebo ID…"
                               aria-label="Hledat rodinu"
                               @bind="_familyFilter"
                               @bind:event="oninput" />
                        @if (IsFamilyFilterActive())
                        {
                            <span class="k-search-count">@VisibleFamilyCount()/@_doc.Families.Count</span>
                            <button type="button" class="k-btn k-btn--ghost k-btn--sm" @onclick="ClearFamilyFilter" title="Zrušit hledání" aria-label="Zrušit hledání">×</button>
                        }
                    </div>
                }

                @* Výběr rodiny je jen výběr: nemění kořen rodokmenu, jen tenhle řádek a tlačítko Upravit. *@
                <p class="k-status" role="status">
                    @if (_doc is null || _doc.Families.Count == 0)
                    {
                        <text>Zatím žádné rodiny.</text>
                    }
                    else if (SelectedFamily() is { } selectedFamily)
                    {
                        <text>Vybraná rodina: </text>

                        <strong>@FamilyDisplay.Partners(_doc, selectedFamily)</strong>

                        <text> · @FamilyChildrenLabel(selectedFamily)</text>
                        @if (FamilyDisplay.MarriageYear(selectedFamily) is { } marriageYear)
                        {
                            <text> · sňatek @marriageYear</text>
                        }
                    }
                    else
                    {
                        <text>Vyberte rodinu v seznamu.</text>
                    }
                </p>

                <div class="k-panel-body k-panel-body--flush">
                    @if (_doc is null || _doc.Individuals.Count == 0)
                    {
                        <div class="k-empty">
                            <div class="k-empty-icon" aria-hidden="true">👪</div>
                            <h3 class="k-empty-title">Rodina potřebuje osoby</h3>
                            <p class="k-empty-text">Rodina spojuje dvě osoby. Přidejte je vedle v panelu <strong>Osoby</strong> a pak se sem vraťte.</p>
                        </div>
                    }
                    else if (_doc.Families.Count == 0)
                    {
                        <div class="k-empty">
                            <div class="k-empty-icon" aria-hidden="true">👪</div>
                            <h3 class="k-empty-title">Zatím žádná rodina</h3>
                            <p class="k-empty-text">Rodina spojuje rodiče s jejich dětmi — bez ní jsou osoby v rodokmenu samostatné ostrovy.</p>
                            <div class="k-empty-actions">
                                <button type="button" class="k-btn k-btn--primary" @onclick="StartNewFamilyAsync">+ Rodina</button>
                            </div>
                        </div>
                    }
                    else if (VisibleFamilyCount() == 0)
                    {
                        <div class="k-empty">
                            <div class="k-empty-icon" aria-hidden="true">🔍</div>
                            <h3 class="k-empty-title">Žádná rodina nenalezena</h3>
                            <p class="k-empty-text">Hledání „@_familyFilter“ neodpovídá žádná rodina.</p>
                            <div class="k-empty-actions">
                                <button type="button" class="k-btn k-btn--outline" @onclick="ClearFamilyFilter">Zrušit hledání</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="k-list">
                            @foreach (var f in GetVisibleFamilies())
                            {
                                var rowId = f.Id;
                                var selected = rowId == _selectedFamilyId;
                                <div class="k-row @(selected ? "is-selected" : "")">
                                    <button type="button"
                                            class="k-row-main"
                                            @onclick="@(() => SelectFamily(rowId))"
                                            aria-pressed="@(selected ? "true" : "false")">
                                        <span class="k-row-name">@FamilyDisplay.Partners(_doc, f)</span>
                                        <span class="k-row-years">@FamilyChildrenLabel(f)</span>
                                    </button>
                                    @if (selected)
                                    {
                                        <button type="button" class="k-btn k-btn--sm k-btn--outline" @onclick="@(() => OpenFamilyForEditAsync(rowId))" title="Upravit vybranou rodinu">Upravit</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </aside>
    </div>
</div>

@if (_showTopolaOverlay && _doc is not null)
{
    <div class="k-overlay"
         tabindex="-1"
         @ref="_topolaOverlayRef"
         @onkeydown="OnTopolaKeyDown">
        <div class="k-overlay-bar">
            <span class="k-overlay-title">
                <svg viewBox="0 0 100 100" width="22" height="22" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="100" height="100" rx="16" fill="#2D5A3D" />
                    <rect x="46" y="38" width="8" height="28" rx="2" fill="#E8D5A3" />
                    <line x1="50" y1="42" x2="30" y2="24" stroke="#E8D5A3" stroke-width="6" stroke-linecap="round" />
                    <line x1="50" y1="42" x2="70" y2="24" stroke="#E8D5A3" stroke-width="6" stroke-linecap="round" />
                    <line x1="50" y1="66" x2="30" y2="82" stroke="#E8D5A3" stroke-width="6" stroke-linecap="round" />
                    <line x1="50" y1="66" x2="70" y2="82" stroke="#E8D5A3" stroke-width="6" stroke-linecap="round" />
                </svg>
                Rodokmen
            </span>
            <button type="button" class="k-btn k-btn--sm" @onclick="PrintTreeFromOverlayAsync">Tisk</button>
            <button type="button" class="k-btn k-btn--sm k-btn--outline" @onclick="DownloadTreeFromOverlayAsync">Stáhnout rodokmen</button>
            <button type="button"
                    class="k-btn k-btn--icon k-btn--ghost"
                    @onclick="CloseTopolaOverlay"
                    title="Zavřít (Esc)"
                    aria-label="Zavřít">×</button>
        </div>
        <div class="k-overlay-body">
            <TopolaTree @ref="_topolaTree"
                        Document="@_doc"
                        RootPersonId="@_rootPersonId"
                        OnPersonSelected="OnTopolaPersonSelected" />
        </div>
    </div>
}

@* Mazání osoby: nejdřív ukázat, co se rozpadne, a nabídnout šetrnější variantu.
   Vlastní dialog místo confirm() — potřebuje strukturovaný obsah a tři možnosti. *@
@if (_deleteImpact is not null)
{
    <div class="k-modal-backdrop">
        <div class="k-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="del-title"
             tabindex="-1"
             @ref="_deleteDialogRef"
             @onkeydown="OnDeleteDialogKeyDown">
            <div class="k-modal-head">
                <h2 class="k-modal-title" id="del-title">Smazat osobu @_deleteImpact.PersonName?</h2>
                <p class="k-modal-sub">Ze souboru změna zmizí až uložením — dokud neuložíte, žije jen v této záložce.</p>
            </div>
            <div class="k-modal-body">
                @if (!_deleteImpact.HasAnyLinks)
                {
                    <p class="k-impact-none">Osoba není v žádné rodině. Smazáním se v rodokmenu nic dalšího nezmění.</p>
                }
                else
                {
                    <ul class="k-impact">
                        @if (_deleteImpact.SpouseFamilyCount > 0)
                        {
                            <li>
                                <span class="k-impact-mark" aria-hidden="true">−</span>
                                <span>Zmizí jako rodič z @_deleteImpact.SpouseFamilyCount @Plural(_deleteImpact.SpouseFamilyCount, "rodiny", "rodin", "rodin").</span>
                            </li>
                        }
                        @if (_deleteImpact.ChildFamilyCount > 0)
                        {
                            <li>
                                <span class="k-impact-mark" aria-hidden="true">−</span>
                                <span>Zmizí jako dítě z @_deleteImpact.ChildFamilyCount @Plural(_deleteImpact.ChildFamilyCount, "rodiny", "rodin", "rodin").</span>
                            </li>
                        }
                        @if (_deleteImpact.LosingParentNames.Count > 0)
                        {
                            <li>
                                <span class="k-impact-mark" aria-hidden="true">!</span>
                                <span>
                                    @_deleteImpact.LosingParentNames.Count
                                    @Plural(_deleteImpact.LosingParentNames.Count, "potomek přijde", "potomci přijdou", "potomků přijde")
                                    o tohoto rodiče — a tím i o celou větev jeho předků:
                                    <ul class="k-names">
                                        @foreach (var n in _deleteImpact.LosingParentNames)
                                        {
                                            <li>@n</li>
                                        }
                                    </ul>
                                </span>
                            </li>
                        }
                        @if (_deleteImpact.EmptiedFamilyIds.Count > 0)
                        {
                            <li>
                                <span class="k-impact-mark" aria-hidden="true">!</span>
                                <span>Bez jediného člena @Plural(_deleteImpact.EmptiedFamilyIds.Count, "zůstane rodina", "zůstanou rodiny", "zůstane rodin") @string.Join(", ", _deleteImpact.EmptiedFamilyIds) — smažte ji zvlášť, pokud ji už nechcete.</span>
                            </li>
                        }
                    </ul>

                    <p>
                        <strong>Zachovat jako neznámou osobu</strong> nechá v rodokmenu prázdný záznam
                        <em>@PersonDisplay.UnknownLabel</em>, který všechny tyhle vazby drží dál. Přijdete o jméno,
                        data i poznámky — <strong>včetně údajů, které editor neumí zobrazit</strong> — ale rodokmen
                        se nerozpadne na kusy.
                    </p>
                }
            </div>
            <div class="k-modal-foot">
                @if (_deleteImpact.HasAnyLinks)
                {
                    <button type="button" class="k-btn k-btn--primary" @onclick="KeepPersonAsUnknown">Zachovat jako neznámou osobu</button>
                }
                @* „úplně" dává smysl jen proti nabídnuté alternativě *@
                <button type="button" class="k-btn k-btn--danger" @onclick="ConfirmDeletePerson">@(_deleteImpact.HasAnyLinks ? "Smazat úplně" : "Smazat")</button>
                <span class="k-spacer"></span>
                <button type="button" class="k-btn k-btn--ghost" @onclick="CancelDeletePerson">Zrušit</button>
            </div>
        </div>
    </div>
}

@* Stáhnout rodokmen z toolbaru: strom se vyrenderuje mimo obrazovku, po dokončení
   (OnReady) se exportuje a stáhne, pak se skrytý kontejner odmountuje a uklidí. *@
@if (_downloadingTree && _doc is not null)
{
    <div style="position: fixed; left: -99999px; top: 0; width: 1280px; height: 800px; overflow: hidden;"
         aria-hidden="true">
        <TopolaTree @ref="_hiddenTopolaTree"
                    Document="@_doc"
                    RootPersonId="@_rootPersonId"
                    OnReady="OnHiddenTreeReadyAsync" />
    </div>
}

@code {
    private GedcomDocument? _doc;
    private string? _loadError;
    private string? _rootPersonId;
    private bool _dirty; // neuložené editace od posledního načtení/exportu

    private PanelView _panel = PanelView.None;
    private bool _personIsNew;
    private bool _familyIsNew;
    private string? _editPersonId;
    private string? _editFamilyId;

    private PersonFormState _personForm = new();

    private FamilyFormState _familyForm = new();
    private readonly Dictionary<string, bool> _fChildSel = new(StringComparer.Ordinal);

    /// <summary>Děti, které rodina měla při otevření — zůstanou v nabídce, i kdyby dnes pravidla nesplňovaly.</summary>
    private readonly HashSet<string> _fOriginalChildIds = new(StringComparer.Ordinal);

    /// <summary>Vybraná rodina v seznamu. Na rozdíl od osoby neřídí nic dalšího — kořen rodokmenu nechává být.</summary>
    private string? _selectedFamilyId;

    /// <summary>
    /// Otisk otevřeného formuláře v okamžiku otevření. Rozdíl proti aktuálnímu stavu = uživatel
    /// do formuláře sáhl, takže jeho zavření je ztráta práce a musí se na ni zeptat (princip 7).
    /// </summary>
    private string _formSnapshot = string.Empty;

    private bool _showTopolaOverlay;
    private ElementReference _topolaOverlayRef;
    private bool _pendingTopolaOverlayFocus;
    private TopolaTree? _topolaTree;

    private bool _downloadingTree;
    private TopolaTree? _hiddenTopolaTree;

    /// <summary>Nenulové = běží dialog mazání osoby; drží spočítaný dopad na rodokmen.</summary>
    private PersonDeletionImpact? _deleteImpact;
    private string? _deletePersonId;
    private ElementReference _deleteDialogRef;
    private bool _pendingDeleteDialogFocus;

    private IJSObjectReference? _exportModule;
    private IJSObjectReference? _unsavedGuardModule;
    private bool _unsavedGuardArmed;

    /// <summary>Strážce se nenačetl — přestaň to zkoušet, ale nezabíjej kvůli tomu editor.</summary>
    private bool _unsavedGuardUnavailable;

    private enum PanelView
    {
        None,
        Person,
        Family,
    }

    protected override void OnInitialized()
    {
        AppState.Document ??= new GedcomDocument();
        _doc = AppState.Document;
        EnsureRootPersonId();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await PreloadJsModulesAsync();
        }

        if (_pendingTopolaOverlayFocus && _showTopolaOverlay)
        {
            _pendingTopolaOverlayFocus = false;
            await _topolaOverlayRef.FocusAsync();
        }

        if (_pendingDeleteDialogFocus && _deleteImpact is not null)
        {
            _pendingDeleteDialogFocus = false;
            await _deleteDialogRef.FocusAsync(); // aby Esc fungoval hned a čtečka dialog ohlásila
        }

        await SyncUnsavedGuardAsync();
    }

    /// <summary>
    /// Všechny vlastní JS moduly aplikace. Seznam je tady, protože jediné místo, kde se
    /// zaručeně načtou všechny, je start — komponenty si je pak berou samy podle potřeby.
    /// </summary>
    private static readonly string[] JsModules =
    {
        "./js/unsaved-guard.js",
        "./js/export.js",
        "./js/topola-view.js", // s ním se staticky natáhne i svg-export.js
    };

    /// <summary>Držené reference na předem načtené moduly — jen aby je nic neuklidilo dřív než stránku.</summary>
    private readonly List<IJSObjectReference> _preloadedModules = new();

    /// <summary>
    /// Kořeny mají po načtení běžet bez sítě: jakmile je aplikace v prohlížeči, výpadek spojení
    /// nesmí být ničí problém. Dynamický <c>import()</c> je ale síťový požadavek — a dokud se
    /// moduly dotahovaly „až bude potřeba“, záviselo první uložení nebo první zobrazení
    /// rodokmenu na tom, že server po hodinách editace pořád stojí.
    ///
    /// Instanci ES modulu drží dokument podle URL, takže stačí každý modul jednou vyžádat tady:
    /// pozdější <c>import()</c> v komponentách sáhne do paměti a na síť už nejde.
    /// </summary>
    private async Task PreloadJsModulesAsync()
    {
        foreach (var path in JsModules)
        {
            try
            {
                var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", path);
                _preloadedModules.Add(module);

                // Rovnou i do polí, která moduly používají — pozdější volání pak nečeká na nic.
                switch (path)
                {
                    case "./js/unsaved-guard.js":
                        _unsavedGuardModule = module;
                        break;
                    case "./js/export.js":
                        _exportModule = module;
                        break;
                }
            }
            catch
            {
                // Nenačtený modul si ošetří ta funkce, které patří; start editoru to nesmí zastavit.
            }
        }
    }

    /// <summary>
    /// Drží beforeunload strážce v souladu s _dirty. Synchronizuje se po renderu, aby
    /// jednotlivá místa nastavující _dirty nemusela být async — stav je jen jeden a přepíná se tu.
    /// </summary>
    private async Task SyncUnsavedGuardAsync()
    {
        if (_unsavedGuardUnavailable || _dirty == _unsavedGuardArmed)
        {
            return;
        }

        try
        {
            var module = await GetUnsavedGuardModuleAsync();
            await module.InvokeVoidAsync(_dirty ? "arm" : "disarm");
            _unsavedGuardArmed = _dirty;
        }
        catch (JSDisconnectedException)
        {
            // Okruh je pryč (reload/zavření) — strážce už nemá co hlídat.
        }
        catch
        {
            // Strážce se nenačetl (výpadek modulu, zastaralá cache po přebuildu…). Běží
            // v OnAfterRender, takže neodchycená výjimka by položila celý editor — a to je
            // za ztrátu jednoho varování příliš. Rozpracovaná transakce zůstává vidět tam,
            // kde na ní záleží nejvíc: tečka v titulku a štítek „Neuloženo“ (princip 4).
            // Zkoušet to při každém renderu znovu nemá smysl, modul se sám neobjeví.
            _unsavedGuardUnavailable = true;
        }
    }

    private async ValueTask<IJSObjectReference> GetUnsavedGuardModuleAsync()
    {
        _unsavedGuardModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/unsaved-guard.js");
        return _unsavedGuardModule;
    }

    private void OpenTopolaOverlay()
    {
        if (_doc is null || _doc.Individuals.Count == 0)
        {
            return;
        }

        _showTopolaOverlay = true;
        _pendingTopolaOverlayFocus = true;
    }

    private void CloseTopolaOverlay()
    {
        _showTopolaOverlay = false;
    }

    /// <summary>Klik na osobu v rodokmenu: přepne kořen a overlay zavře (stejné chování jako klik v HourglassTree).</summary>
    private Task OnTopolaPersonSelected(string id)
    {
        _rootPersonId = id;
        CloseTopolaOverlay();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OnTopolaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseTopolaOverlay();
        }
    }

    /// <summary>Stáhne celý rodokmen jako samostatné SVG (nezávislé na aktuálním pan/zoom).</summary>
    private async Task DownloadTreeFromOverlayAsync()
    {
        if (_topolaTree is null)
        {
            return;
        }

        var svg = await _topolaTree.ExportSvgAsync();
        if (string.IsNullOrEmpty(svg))
        {
            return;
        }

        var module = await GetExportModuleAsync();
        await module.InvokeVoidAsync("downloadSvg", svg, "koreny-rodokmen.svg");
    }

    /// <summary>Tisk exportovaného (zoom-resetnutého) SVG — celý strom, ne aktuální výřez.</summary>
    private async Task PrintTreeFromOverlayAsync()
    {
        if (_topolaTree is null)
        {
            return;
        }

        var svg = await _topolaTree.ExportSvgAsync();
        if (string.IsNullOrEmpty(svg))
        {
            return;
        }

        var module = await GetExportModuleAsync();
        await module.InvokeVoidAsync("printSvg", svg);
    }

    /// <summary>Stáhnout rodokmen z toolbaru bez otevření overlaye: vyrenderuje skrytý strom (viz markup).</summary>
    private void StartTreeDownload()
    {
        if (_doc is null || _doc.Individuals.Count == 0 || _downloadingTree)
        {
            return;
        }

        _downloadingTree = true; // skrytý TopolaTree se namountuje a po dokončení zavolá OnHiddenTreeReadyAsync
    }

    private async Task OnHiddenTreeReadyAsync()
    {
        try
        {
            if (_hiddenTopolaTree is not null)
            {
                var svg = await _hiddenTopolaTree.ExportSvgAsync();
                if (!string.IsNullOrEmpty(svg))
                {
                    var module = await GetExportModuleAsync();
                    await module.InvokeVoidAsync("downloadSvg", svg, "koreny-rodokmen.svg");
                }
            }
        }
        finally
        {
            _downloadingTree = false; // odmountuje skrytý kontejner → DisposeAsync uklidí
            StateHasChanged();
        }
    }

    /// <summary>
    /// Rodinu na rozdíl od osoby nepředvybíráme: výběr nic neřídí, takže „nic nevybráno" je
    /// platný stav a předvýběr by jen předstíral rozhodnutí, které uživatel neudělal.
    /// Hlídá se jen to, aby výběr neukazoval na rodinu, která už v dokumentu není.
    /// </summary>
    private void EnsureSelectedFamilyId()
    {
        if (string.IsNullOrEmpty(_selectedFamilyId))
        {
            return;
        }

        if (_doc is null || _doc.Families.All(f => f.Id != _selectedFamilyId))
        {
            _selectedFamilyId = null;
        }
    }

    private void EnsureRootPersonId()
    {
        _doc = AppState.Document;
        if (_doc is null || _doc.Individuals.Count == 0)
        {
            _rootPersonId = null;
            return;
        }

        if (string.IsNullOrEmpty(_rootPersonId) || _doc.Individuals.All(x => x.Id != _rootPersonId))
        {
            _rootPersonId = _doc.Individuals[0].Id;
        }
    }

    private Task OnTreePersonSelected(string id)
    {
        _rootPersonId = id;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnTreePersonDoubleClicked(string id)
    {
        _rootPersonId = id;
        await OpenPersonForEditAsync(id);
        StateHasChanged();
    }

    /// <summary>Klik na řádek seznamu = výběr osoby (řídí HourglassTree i akce rodokmenu). Bez toggle, bez otevření editoru.</summary>
    private void SelectPerson(string id)
    {
        _rootPersonId = id;
        StateHasChanged();
    }

    /// <summary>Osoba pro stavový řádek; null = nic není vybráno.</summary>
    private GedcomIndividual? SelectedPerson() =>
        _doc is null || string.IsNullOrEmpty(_rootPersonId)
            ? null
            : _doc.Individuals.FirstOrDefault(x => x.Id == _rootPersonId);

    /// <summary>
    /// Klik na řádek seznamu rodin = výběr rodiny, nic víc. Vědomě NEmění kořen rodokmenu:
    /// rodina není osoba, takže by se muselo hádat, který její člen má být kořenem.
    /// </summary>
    private void SelectFamily(string id)
    {
        _selectedFamilyId = id;
        StateHasChanged();
    }

    /// <summary>Rodina pro stavový řádek; null = nic není vybráno.</summary>
    private GedcomFamily? SelectedFamily()
    {
        if (_doc is null || string.IsNullOrEmpty(_selectedFamilyId))
        {
            return null;
        }

        return _doc.Families.FirstOrDefault(f => f.Id == _selectedFamilyId);
    }

    /// <summary>Počet dětí v protějšku sloupce s letopočty u osob — rodina ho má vždy, datum sňatku často ne.</summary>
    private string FamilyChildrenLabel(GedcomFamily family) =>
        family.ChildrenIds.Count == 0
            ? "bez dětí"
            : $"{family.ChildrenIds.Count} {Plural(family.ChildrenIds.Count, "dítě", "děti", "dětí")}";

    private string _personFilter = string.Empty;

    private bool IsPersonFilterActive() => !string.IsNullOrWhiteSpace(_personFilter);

    /// <summary>Seřazené osoby po aplikaci hledání (bez diakritiky a velikosti písmen, viz PersonSearch).</summary>
    private List<GedcomIndividual> GetVisibleIndividuals() =>
        PersonSearch.Filter(GetIndividualsSorted(), _personFilter).ToList();

    private int VisiblePersonCount() => GetVisibleIndividuals().Count;

    private void ClearPersonFilter() => _personFilter = string.Empty;

    private IEnumerable<GedcomIndividual> GetIndividualsSorted()
    {
        if (_doc is null)
        {
            return Enumerable.Empty<GedcomIndividual>();
        }

        return _doc.Individuals
            .OrderBy(p => p.Name?.Surname ?? "", StringComparer.OrdinalIgnoreCase)
            .ThenBy(p => p.Name?.GivenName ?? "", StringComparer.OrdinalIgnoreCase);
    }

    private string _familyFilter = string.Empty;

    private bool IsFamilyFilterActive() => !string.IsNullOrWhiteSpace(_familyFilter);

    /// <summary>Seřazené rodiny po aplikaci hledání (stejná pravidla jako u osob, viz FamilySearch).</summary>
    private List<GedcomFamily> GetVisibleFamilies() =>
        FamilySearch.Filter(_doc, GetFamiliesSorted(), _familyFilter).ToList();

    private int VisibleFamilyCount() => GetVisibleFamilies().Count;

    private void ClearFamilyFilter() => _familyFilter = string.Empty;

    /// <summary>
    /// Rodiny podle jmen rodičů, aby se seznam dal projít stejně jako seznam osob.
    /// Rodiny bez rodičů jdou na konec — jinak by je závorka v popisku vytlačila na začátek,
    /// kde by rozpracované záznamy zakrývaly ty hotové.
    /// </summary>
    private IEnumerable<GedcomFamily> GetFamiliesSorted()
    {
        if (_doc is null)
        {
            return Enumerable.Empty<GedcomFamily>();
        }

        return _doc.Families
            .OrderBy(f => f.HusbandId is null && f.WifeId is null)
            .ThenBy(f => FamilyDisplay.Partners(_doc, f), StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>Nastaveno, když osoba vzniká z prázdného stavu „nová rodina" — po uložení se vrátíme k rodině.</summary>
    private bool _returnToNewFamilyAfterPerson;

    private void StartNewPerson()
    {
        if (_doc is null)
        {
            return;
        }

        _panel = PanelView.Person;
        _personIsNew = true;
        _editPersonId = null;
        _personForm = new PersonFormState();
        _formSnapshot = CurrentFormSignature();
    }

    private async Task StartNewPersonAsync()
    {
        if (_doc is null || !await ConfirmDiscardOpenFormAsync())
        {
            return;
        }

        StartNewPerson();
        StateHasChanged();
    }

    private async Task StartNewPersonThenReturnToFamilyAsync()
    {
        if (_doc is null || !await ConfirmDiscardOpenFormAsync())
        {
            return;
        }

        _returnToNewFamilyAfterPerson = true;
        StartNewPerson();
        StateHasChanged();
    }

    private void OpenPersonForEdit(string id)
    {
        if (_doc is null)
        {
            return;
        }

        _panel = PanelView.Person;
        _personIsNew = false;
        _editPersonId = id;
        var p = _doc.Individuals.First(x => x.Id == id);
        _personForm = new PersonFormState();
        _personForm.Fill(p);
        _formSnapshot = CurrentFormSignature();
    }

    private async Task OpenPersonForEditAsync(string id)
    {
        if (_doc is null || !await ConfirmDiscardOpenFormAsync())
        {
            return;
        }

        OpenPersonForEdit(id);
        StateHasChanged();
    }

    private void SavePerson()
    {
        if (_doc is null)
        {
            return;
        }

        GedcomIndividual ind;
        if (_personIsNew)
        {
            ind = new GedcomIndividual { Id = NextIndividualId() };
            _doc.Individuals.Add(ind);
        }
        else
        {
            if (string.IsNullOrEmpty(_editPersonId))
            {
                return;
            }

            ind = _doc.Individuals.First(x => x.Id == _editPersonId);
        }

        _personForm.ApplyTo(ind);
        GedcomSync.SyncIndividual(_doc, ind);
        _doc.InvalidateLookups();
        _dirty = true;
        ClosePanel();
        if (_returnToNewFamilyAfterPerson)
        {
            _returnToNewFamilyAfterPerson = false;
            StartNewFamily();
        }

        EnsureRootPersonId();
        StateHasChanged();
    }

    /// <summary>
    /// Mazání se nikdy neprovede rovnou: nejdřív se spočítá dopad na zbytek rodokmenu
    /// a uživatel ho vidí v dialogu (docs/principy.md, princip 7).
    /// </summary>
    private void DeletePerson()
    {
        var ind = PersonBeingEdited();
        if (ind is null)
        {
            return;
        }

        _deletePersonId = ind.Id;
        _deleteImpact = DeletionImpact.ForPerson(_doc!, ind);
        _pendingDeleteDialogFocus = true;
    }

    private GedcomIndividual? PersonBeingEdited()
    {
        if (_doc is null || _personIsNew || string.IsNullOrEmpty(_editPersonId))
        {
            return null;
        }

        return _doc.Individuals.FirstOrDefault(x => x.Id == _editPersonId);
    }

    private void CancelDeletePerson()
    {
        _deleteImpact = null;
        _deletePersonId = null;
    }

    private void OnDeleteDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelDeletePerson();
        }
    }

    private void ConfirmDeletePerson()
    {
        var ind = PersonToDelete();
        if (ind is not null)
        {
            GedcomSync.RemoveIndividual(_doc!, ind); // včetně HUSB/WIFE/CHIL odkazů na ni
            FinishPersonDeletion();
        }
    }

    /// <summary>Šetrnější varianta: záznam i vazby zůstanou, zmizí jen identita.</summary>
    private void KeepPersonAsUnknown()
    {
        var ind = PersonToDelete();
        if (ind is not null)
        {
            GedcomSync.AnonymizeIndividual(_doc!, ind);
            FinishPersonDeletion();
        }
    }

    /// <summary>Osoba, které se dialog týká — čte se z ID, ne z reference, aby prošla i změna dokumentu mezitím.</summary>
    private GedcomIndividual? PersonToDelete() =>
        _doc is null || string.IsNullOrEmpty(_deletePersonId)
            ? null
            : _doc.Individuals.FirstOrDefault(x => x.Id == _deletePersonId);

    private void FinishPersonDeletion()
    {
        var removedId = _deletePersonId;
        CancelDeletePerson();

        _dirty = true;
        if (_rootPersonId == removedId && _doc?.FindIndividual(removedId) is null)
        {
            _rootPersonId = null;
        }

        ClosePanel();
        EnsureRootPersonId();
        EnsureSelectedFamilyId();
        StateHasChanged();
    }

    private void StartNewFamily()
    {
        _panel = PanelView.Family;
        _familyIsNew = true;
        _editFamilyId = null;
        ClearFamilyForm();
        _formSnapshot = CurrentFormSignature();
    }

    private async Task StartNewFamilyAsync()
    {
        if (_doc is null || !await ConfirmDiscardOpenFormAsync())
        {
            return;
        }

        StartNewFamily();
        StateHasChanged();
    }

    private void OpenFamilyForEdit(string id)
    {
        if (_doc is null)
        {
            return;
        }

        var f = _doc.Families.First(x => x.Id == id);
        _panel = PanelView.Family;
        _familyIsNew = false;
        _editFamilyId = id;
        _selectedFamilyId = id;
        _familyForm = new FamilyFormState();
        _familyForm.Fill(f);
        _fChildSel.Clear();
        _fOriginalChildIds.Clear();
        foreach (var p in _doc.Individuals)
        {
            var isChild = f.ChildrenIds.Contains(p.Id);
            _fChildSel[p.Id] = isChild;
            if (isChild)
            {
                _fOriginalChildIds.Add(p.Id);
            }
        }

        _formSnapshot = CurrentFormSignature();
    }

    private async Task OpenFamilyForEditAsync(string id)
    {
        if (_doc is null || !await ConfirmDiscardOpenFormAsync())
        {
            return;
        }

        OpenFamilyForEdit(id);
        StateHasChanged();
    }

    private void ClearFamilyForm()
    {
        _familyForm = new FamilyFormState();
        _fChildSel.Clear();
        _fOriginalChildIds.Clear();
        if (_doc is not null)
        {
            foreach (var p in _doc.Individuals)
            {
                _fChildSel[p.Id] = false;
            }
        }
    }

    private bool IsFamilyChildChecked(string id) =>
        _fChildSel.TryGetValue(id, out var v) && v;

    private void OnFamilyChildToggle(string id, ChangeEventArgs e)
    {
        if (e.Value is bool on)
        {
            _fChildSel[id] = on;
        }
    }

    private bool HasFamilyParentSelected() =>
        !string.IsNullOrEmpty(_familyForm.HusbandId) || !string.IsNullOrEmpty(_familyForm.WifeId);

    /// <summary>Osoby nabídnutelné jako děti — bez rodičů rodiny a jejich předků (viz RelationshipRules).</summary>
    private List<GedcomIndividual> FamilyChildCandidates() =>
        _doc is null
            ? new List<GedcomIndividual>()
            : RelationshipRules.ChildCandidates(_doc, _familyForm.HusbandId, _familyForm.WifeId, _fOriginalChildIds);

    /// <summary>
    /// Po změně rodiče odškrtne děti, které by nově tvořily cyklus — typicky když se jako rodič
    /// zvolí někdo, kdo je mezi zaškrtnutými dětmi nebo je jejich potomkem.
    /// </summary>
    private void OnFamilyParentsChanged()
    {
        if (_doc is null)
        {
            return;
        }

        foreach (var id in _fChildSel.Where(kv => kv.Value).Select(kv => kv.Key).ToList())
        {
            if (!RelationshipRules.CanBeChild(_doc, _familyForm.HusbandId, _familyForm.WifeId, id))
            {
                _fChildSel[id] = false;
            }
        }
    }

    private void SaveFamily()
    {
        if (_doc is null || _doc.Individuals.Count == 0)
        {
            return;
        }

        GedcomFamily fam;
        if (_familyIsNew)
        {
            fam = new GedcomFamily { Id = NextFamilyId() };
            _doc.Families.Add(fam);
        }
        else
        {
            if (string.IsNullOrEmpty(_editFamilyId))
            {
                return;
            }

            fam = _doc.Families.First(x => x.Id == _editFamilyId);
        }

        // Vybrané děti v pořadí seznamu osob; SyncFamily zachová pořadí existujících CHIL uzlů.
        // Pojistka proti cyklu: nově přidané dítě musí projít pravidly i tady, ne jen v UI.
        // Původní děti se propouštějí, aby se import s existujícím cyklem uložením neořezal.
        _familyForm.ChildIds = _doc.Individuals
            .Where(p => _fChildSel.TryGetValue(p.Id, out var on) && on)
            .Where(p => _fOriginalChildIds.Contains(p.Id)
                        || RelationshipRules.CanBeChild(_doc, _familyForm.HusbandId, _familyForm.WifeId, p.Id))
            .Select(p => p.Id)
            .ToList();
        _familyForm.ApplyTo(fam);

        GedcomSync.SyncFamily(_doc, fam);
        _doc.InvalidateLookups();
        _dirty = true;
        ClosePanel();
        EnsureSelectedFamilyId();
        StateHasChanged();
    }

    /// <summary>
    /// Smazání rodiny osoby nemaže, ale trhá vazby mezi nimi — a to se nesmí stát potichu
    /// (docs/principy.md, princip 7). Prostý confirm stačí: dopad je jedna věta, ne seznam.
    /// </summary>
    private async Task DeleteFamilyAsync()
    {
        if (_doc is null || _familyIsNew || string.IsNullOrEmpty(_editFamilyId))
        {
            return;
        }

        var fam = _doc.Families.FirstOrDefault(x => x.Id == _editFamilyId);
        if (fam is not null)
        {
            if (!await JSRuntime.InvokeAsync<bool>("confirm", DeleteFamilyQuestion(fam)))
            {
                return;
            }

            GedcomSync.RemoveFamily(_doc, fam); // včetně FAMS/FAMC odkazů na ni
        }

        _dirty = true;
        ClosePanel();
        EnsureSelectedFamilyId();
        StateHasChanged();
    }

    private string DeleteFamilyQuestion(GedcomFamily fam)
    {
        var parents = new[] { fam.HusbandId, fam.WifeId }.Count(id => !string.IsNullOrEmpty(id));
        var kids = fam.ChildrenIds.Count;

        if (kids == 0)
        {
            return "Smazat rodinu? Osoby zůstanou, zmizí jen jejich vzájemná vazba.";
        }

        return $"Smazat rodinu? Osoby zůstanou v rodokmenu, ale {kids} "
            + $"{Plural(kids, "dítě přijde", "děti přijdou", "dětí přijde")} o vazbu na "
            + $"{Plural(parents, "svého rodiče", "své rodiče", "své rodiče")}.";
    }

    private void CancelPanel()
    {
        // Zrušením formuláře zaniká i záměr „přidat osobu a vrátit se k nové rodině",
        // jinak by na něj narazilo až příští uložení jiné osoby.
        _returnToNewFamilyAfterPerson = false;
        ClosePanel();
    }

    /// <summary>Oba panely zpět na seznam. S formulářem zaniká i jeho otisk, jinak by strážil cizí stav.</summary>
    private void ClosePanel()
    {
        _panel = PanelView.None;
        _formSnapshot = string.Empty;
    }

    /// <summary>Oddělovač polí v otisku — řídicí znak, který se v GEDCOM hodnotách nevyskytuje.</summary>
    private const char FormFieldSeparator = (char)31; // ASCII Unit Separator

    /// <summary>
    /// Otisk editovatelných polí otevřeného formuláře. Slouží jedinému účelu — poznat, jestli
    /// se do formuláře sáhlo — proto stačí porovnání řetězců a nezáleží na formátu.
    /// </summary>
    private string CurrentFormSignature() => _panel switch
    {
        PanelView.Person => string.Join(
            FormFieldSeparator,
            _personForm.Given,
            _personForm.Surname,
            _personForm.MaidenSurname,
            _personForm.SexCode.ToString(CultureInfo.InvariantCulture),
            _personForm.BirthDate,
            _personForm.BirthPlace,
            _personForm.DeathDate,
            _personForm.DeathPlace,
            _personForm.NoteFirst),
        PanelView.Family => string.Join(
            FormFieldSeparator,
            _familyForm.HusbandId,
            _familyForm.WifeId,
            _familyForm.MarriageDate,
            _familyForm.MarriagePlace,
            string.Join(',', _fChildSel.Where(kv => kv.Value).Select(kv => kv.Key).OrderBy(x => x, StringComparer.Ordinal))),
        _ => string.Empty,
    };

    /// <summary>
    /// Rozepsaný formulář je globálně jeden, takže otevření druhého ten první zavírá. Neuloženou
    /// práci ale nesmíme zahodit potichu (princip 7) — otázka říká, co konkrétně se ztratí.
    /// Formulář, do kterého uživatel nesáhl, se zavírá bez ptaní: není co ztratit.
    /// </summary>
    private async Task<bool> ConfirmDiscardOpenFormAsync()
    {
        if (_panel == PanelView.None || CurrentFormSignature() == _formSnapshot)
        {
            return true;
        }

        var loss = _panel switch
        {
            PanelView.Person => _personIsNew
                ? "Rozepsaná nová osoba se neuloží a zmizí."
                : "Neuložené změny osoby se zahodí; osoba zůstane, jak byla.",
            _ => _familyIsNew
                ? "Rozepsaná nová rodina se neuloží a zmizí."
                : "Neuložené změny rodiny se zahodí; rodina zůstane, jak byla.",
        };

        return await JSRuntime.InvokeAsync<bool>("confirm", $"{loss} Pokračovat?");
    }

    private string NextIndividualId()
    {
        var max = 0;
        foreach (var i in _doc!.Individuals)
        {
            if (i.Id.Length > 1 && i.Id[0] == 'I' && int.TryParse(i.Id.AsSpan(1), out var n))
            {
                max = Math.Max(max, n);
            }
        }

        return $"I{max + 1}";
    }

    private string NextFamilyId()
    {
        var max = 0;
        foreach (var f in _doc!.Families)
        {
            if (f.Id.Length > 1 && f.Id[0] == 'F' && int.TryParse(f.Id.AsSpan(1), out var n))
            {
                max = Math.Max(max, n);
            }
        }

        return $"F{max + 1}";
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _loadError = null;
        var file = e.File;
        if (file is null)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 50_000_000);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            var text = await reader.ReadToEndAsync();
            LoadGedcomText(text);
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    /// <summary>Načtení vzorového GEDCOMu z embedded resource — toutéž cestou parseru jako upload.</summary>
    private async Task LoadSampleGedcomAsync()
    {
        if (_dirty)
        {
            var proceed = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                "Nahraný dokument má neuložené změny. Načtením vzorového GEDCOMu se přepíší. Pokračovat?");
            if (!proceed)
            {
                return;
            }
        }

        _loadError = null;
        try
        {
            LoadGedcomText(SampleGedcom.ReadText());
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    /// <summary>Jediný vstupní bod načtení dokumentu (upload i vzorový GEDCOM sdílejí tuto cestu).</summary>
    private void LoadGedcomText(string text) => ApplyDocument(Parser.Parse(text));

    /// <summary>
    /// Prázdný rodokmen „na zelené louce". Ptáme se, jen když je co ztratit; text rozlišuje,
    /// zda jsou změny neuložené (data zmizí nenávratně) nebo jen načtené ze souboru.
    /// </summary>
    private async Task StartNewDocumentAsync()
    {
        if (HasAnyRecords())
        {
            var question = _dirty
                ? "Rozdělaný rodokmen má neuložené změny. Založením nového o ně přijdete. Pokračovat?"
                : "Aktuální rodokmen se zavře a začnete s prázdným. Pokračovat?";
            if (!await JSRuntime.InvokeAsync<bool>("confirm", question))
            {
                return;
            }
        }

        _loadError = null;
        ApplyDocument(new GedcomDocument());
    }

    /// <summary>Česká číslovka: 1 osoba, 2–4 osoby, 0 a 5+ osob.</summary>
    private static string Plural(int count, string one, string few, string many) =>
        count == 1 ? one : (count >= 2 && count <= 4 ? few : many);

    private bool HasAnyRecords() =>
        _doc is not null && (_doc.Individuals.Count > 0 || _doc.Families.Count > 0);

    /// <summary>
    /// Výměna dokumentu na jednom místě — načtení souboru, vzorová rodina i nový prázdný
    /// rodokmen sdílejí tentýž reset, aby se nezapomněl vynulovat některý stav formulářů.
    /// </summary>
    private void ApplyDocument(GedcomDocument document)
    {
        AppState.Document = document;
        _doc = document;
        ClosePanel();
        CancelDeletePerson();                  // dialog se týkal osoby, která už tu není
        _returnToNewFamilyAfterPerson = false; // nový dokument ruší rozdělanou cestu „nová rodina"
        _personFilter = string.Empty;          // hledání se nevztahuje k novým datům
        _familyFilter = string.Empty;
        _selectedFamilyId = null;              // výběr patřil rodině z minulého dokumentu
        EnsureRootPersonId();
        EnsureSelectedFamilyId();
        _dirty = false;
        StateHasChanged();
    }

    private async Task ExportGedcomAsync()
    {
        if (_doc is null)
        {
            return;
        }

        var text = GedcomWriter.Write(_doc);
        var module = await GetExportModuleAsync();
        await module.InvokeVoidAsync("downloadText", text, "koreny-export.ged", "text/plain;charset=utf-8");
        _dirty = false;
    }

    private async ValueTask<IJSObjectReference> GetExportModuleAsync()
    {
        if (_exportModule is not null)
        {
            return _exportModule;
        }

        _exportModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/export.js");
        return _exportModule;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_unsavedGuardModule is not null)
            {
                if (_unsavedGuardArmed)
                {
                    await _unsavedGuardModule.InvokeVoidAsync("disarm");
                }

                await _unsavedGuardModule.DisposeAsync();
            }

            if (_exportModule is not null)
            {
                await _exportModule.DisposeAsync();
            }

            foreach (var module in _preloadedModules)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Okruh je pryč — JS strana zmizela i s posluchačem.
        }

        _unsavedGuardModule = null;
        _unsavedGuardArmed = false;
        _exportModule = null;
        _preloadedModules.Clear();
    }
}
